NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only (never prefix with NEXT_PUBLIC_). Used only to delete
# orphaned event flyer files. Optional: without it, flyer cleanup is skipped.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Any long random string; Vercel Cron sends it to /api/cron/cleanup-flyers.
CRON_SECRET=a_long_random_string
